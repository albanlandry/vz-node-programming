{
  "name": "vz-programming",
  "version": "1.0.0",
  "description": "A Node-based programming system with TypeScript support",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "example": "npm run build && node dist/examples/usage-examples.js",
    "example:http": "npm run build && node dist/examples/http-example.js",
    "example:simple-http": "npm run build && node dist/examples/simple-http.js",
    "example:parallel": "npm run build && node dist/examples/parallel-execution.js",
    "example:registry": "npm run build && node dist/examples/registry-example.js",
    "example:errors": "npm run build && node dist/examples/error-handling-example.js",
    "example:logger": "npm run build && node dist/examples/logger-example.js",
    "example:build": "tsc",
    "example:run": "node dist/examples/usage-examples.js",
    "test": "jest",
    "lint": "eslint . --ext .ts,.tsx --ignore-pattern 'examples/**'",
    "lint:strict": "eslint . --ext .ts,.tsx --max-warnings 0 --ignore-pattern 'examples/**'",
    "lint:fix": "eslint . --ext .ts,.tsx --fix --ignore-pattern 'examples/**'",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist",
    "frontend:dev": "next dev",
    "frontend:build": "next build",
    "frontend:start": "next start",
    "frontend:lint": "next lint"
  },
  "keywords": [
    "node-based",
    "programming",
    "typescript",
    "async",
    "functional",
    "oop"
  ],
  "author": "VZ Programming",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.33",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-unused-imports": "^3.2.0",
    "jest": "^29.0.0",
    "next": "^14.0.0",
    "postcss": "^8.4.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwindcss": "^3.3.0",
    "ts-jest": "^29.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@types/uuid": "^9.0.0",
    "@xyflow/react": "^12.9.2",
    "lucide-react": "^0.552.0",
    "react-draggable": "^4.5.0",
    "reactflow": "^11.11.4",
    "uuid": "^9.0.0",
    "zustand": "^5.0.8"
  }
}
